# E-Commerce Lakehouse MLOps - Environment Configuration
# Copy this to .env and fill in your values. Never commit .env to git.

# GCP Project ID (for BigQuery billing/quota)
GCP_PROJECT_ID=ecommerce-lakehouse-mlops

# Authentication: Uses Google Application Default Credentials (ADC).
# No service account JSON key needed.
# Run these commands before using the extraction script:
#   gcloud auth login
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project ecommerce-lakehouse-mlops
