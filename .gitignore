# Environment variables (contains credentials)
.env

# Extracted data files (too large for git, reproducible via extraction script)
data/*.parquet
data/*.csv
!data/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
*.egg

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# MLflow
mlruns/
mlflow.db

# GCP credentials (never commit these)
*.json
!feast/*.json
!docs/*.json
!evidently/monitoring_summary.json

# Databricks
.databricks/


# Raw and intermediate data (pipeline-only, not needed by the app)
data/*.parquet

